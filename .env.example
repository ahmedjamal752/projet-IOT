# Seuil d'alerte en °C
ALERT_TEMP_THRESHOLD=30.0

# --------------------------------------------------------
# 1. OPTION WHATSAPP GRATUITE (CallMeBot)
# Numéro officiel actif CallMeBot : +34 623 78 64 49 (ou +34 621 062 163)
# Envoyez par WhatsApp "I allow callmebot to send me messages"
# Vous recevrez instantanément votre CALLMEBOT_API_KEY.
# --------------------------------------------------------
