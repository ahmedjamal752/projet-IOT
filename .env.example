TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# --------------------------------------------------------
# 3. CONFIGURATION ENVOI EMAIL (Gmail SMTP)
# Créez un mot de passe d'application sur votre compte Google :
# Sécurité Google -> Validation en 2 étapes -> Mots de passe d'application
